#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

VERB="${1:-}"

usage() {
  cat <<EOF
pokit — POKit CLI Wrapper (v0.9.0)

Usage: pokit <verb> [args...]

Available verbs:
  start     Start a POKit session
  brief     Show session brief / detail view
  run       Run sprint cycle — generate PRD/criteria artifacts
  close     Close a cycle — finalize run summary and retro
  retro     Generate retrospective summary
  hotfix    Plan a hotfix cycle
  audit     Run release MD audit
  guard     Run cycle guard checks
  progress  Show cycle progress visualization
  end       Close a session — write resume brief
  safety    Run public safety scan before GitHub push/tag
  role-check  Validate docs/_details/role-map.yaml — path existence + max_lines
  retro-check Inspect prior release manifest wiring + dispatch pokit:gap issues
  next-action Run next-action wizard (박제 목표·이슈·의도 입력)
  help      Show this help message

All verbs go through scripts/internal/verb-dispatch.ts.
Errors produce ASCII Problem/Error Review + artifacts/backlog/*-problem-review.md.
EOF
}

case "$VERB" in
  help|-h|--help|"")
    usage
    exit 0
    ;;
esac

exec node --experimental-strip-types "$PROJECT_ROOT/scripts/internal/verb-dispatch.ts" "$@"
